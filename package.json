{
  "name": "remote-hands",
  "version": "0.1.0",
  "description": "A CLI-installable agent that runs on your infrastructure and is driven from Slack.",
  "keywords": [
    "slack",
    "claude",
    "agent",
    "devops",
    "sre",
    "chatops",
    "cli"
  ],
  "license": "MIT",
  "author": "Revanth Arumalla <revanthreddy128@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArumallaRevanthReddy/remote-hands.git"
  },
  "homepage": "https://github.com/ArumallaRevanthReddy/remote-hands#readme",
  "bugs": {
    "url": "https://github.com/ArumallaRevanthReddy/remote-hands/issues"
  },
  "type": "module",
  "bin": {
    "remote-hands": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@inquirer/prompts": "^8.5.2",
    "@slack/bolt": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
