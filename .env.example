# Slack app credentials. Socket Mode, so the host needs no public URL —
# it dials out to Slack. Create the app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Anthropic API key. The Agent SDK requires API key auth for third-party
# agents; claude.ai login is not permitted for distributed products.
ANTHROPIC_API_KEY=sk-ant-...

# Directory the agent works in. Session transcripts are keyed to this path,
# so changing it orphans existing threads' history.
RH_WORKSPACE=/srv/remote-hands/workspace

# Where the Slack-thread -> session map is stored.
RH_STATE=/var/lib/remote-hands/sessions.json

# Optional overrides
# RH_MODEL=claude-opus-5
# RH_MAX_TURNS=30
