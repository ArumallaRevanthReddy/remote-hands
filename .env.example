# Environment overrides.
#
# You do not need this file. `remote-hands init` writes everything to
# ~/.remote-hands/config.json instead. These variables exist for containers,
# systemd units, and CI — anywhere an interactive setup step doesn't fit.
#
# Anything set here wins over the config file. Use `remote-hands doctor` to see
# which source each value is actually coming from.

# Anthropic API key. Set this instead of running init if you'd rather no
# credential were written to disk at all.
ANTHROPIC_API_KEY=sk-ant-...

# Slack credentials. Set both or neither — one alone is a misconfiguration and
# will be rejected at startup rather than silently half-working.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Directory the agent works in. Session transcripts are keyed to this path,
# so changing it orphans the history of existing conversations.
# RH_WORKSPACE=/srv/remote-hands/workspace

# Optional
# RH_MODEL=claude-opus-5
# RH_MAX_TURNS=30
# RH_CONFIG_DIR=/etc/remote-hands

# Policy. "approval" (default) asks before anything that could change state;
# "readonly" refuses those outright instead of asking.
# RH_MODE=approval

# Seconds an approval waits for a click before denying itself. The agent is
# blocked mid-turn while it waits, so this cannot be disabled.
# RH_APPROVAL_TIMEOUT=300
